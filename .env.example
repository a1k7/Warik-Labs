# Copy to .env.local for local development. Never commit .env.local.
APP_ENV=development
APP_NAME=Warik Labs
API_HOST=0.0.0.0
API_PORT=8000

# Local Compose defaults only. Postgres is published on host port 5433 to avoid collisions with an existing local PostgreSQL service.
DATABASE_URL=postgresql+psycopg://warik:warik_dev_only@localhost:5433/warik
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins. No wildcard in production.
CORS_ORIGINS=http://localhost:3000

# Generate a fresh value locally: openssl rand -hex 32
# Leave empty in this committed template.
JWT_SECRET=

# Public URL only; never put API keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# External integrations are deliberately disabled in Phase 1.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Use a newly rotated key only. Never reuse a credential exposed in the old repo/chat.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GNANI_API_KEY=
DUFFEL_API_KEY=
GEOAPIFY_API_KEY=

# Local demo policy. Payments are excluded; browser actions are disabled.
PAYMENTS_ENABLED=false
LIVE_BROWSER_ACTIONS_ENABLED=false
