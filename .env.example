# Copy to .env.local for local development. Never commit .env.local.
APP_ENV=development
APP_NAME=Warik Labs
API_HOST=0.0.0.0
API_PORT=8000

# Local Compose defaults only. Postgres is published on host port 5433.
DATABASE_URL=postgresql+psycopg://warik:warik_dev_only@localhost:5433/warik
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins. No wildcard in production.
CORS_ORIGINS=http://localhost:3000

# Leave empty in the committed template. Generate a fresh local value.
JWT_SECRET=

# Public API URL only. Never put credentials in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional server-side reasoning provider. Only configure a freshly rotated key.
# The companion runs deterministic local planning when this is blank.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Messaging and external actions are not enabled in this MVP.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
GNANI_API_KEY=
DUFFEL_API_KEY=
GEOAPIFY_API_KEY=
PAYMENTS_ENABLED=false
LIVE_BROWSER_ACTIONS_ENABLED=false
